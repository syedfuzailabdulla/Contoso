{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "resources": [
    {
      "type": "Microsoft.Authorization/policyDefinitions",
      "apiVersion": "2021-06-01",
      "name": "full-access-policy",
      "properties": {
        "displayName": "Full Access Policy",
        "description": "Grants full access to all resource types and operations",
        "policyType": "Custom",
        "mode": "All",
        "policyRule": {
          "if": {
            "value": "true",
            "equals": "false"
          },
          "then": {
            "effect": "Allow"
          }
        }
      }
    },
    {
      "type": "Microsoft.Authorization/policyAssignments",
      "apiVersion": "2022-06-01",
      "name": "full-access-assignment",
      "dependsOn": [
        "[resourceId('Microsoft.Authorization/policyDefinitions', 'full-access-policy')]"
      ],
      "properties": {
        "displayName": "Full Access Assignment",
        "policyDefinitionId": "[resourceId('Microsoft.Authorization/policyDefinitions', 'full-access-policy')]",
        "scope": "[subscription().id]"
      }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(subscription().id, 'full-access-role')]",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', 'b24988ac-6180-42a0-ab88-20f7382dd24c')]",
        "principalId": "[parameters('principalId')]",
        "principalType": "ServicePrincipal"
      }
    }
  ],
  "parameters": {
    "principalId": {
      "type": "string",
      "metadata": {
        "description": "Object ID of the Service Principal or User to assign Contributor role"
      }
    }
  },
  "outputs": {
    "policyDefinitionId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Authorization/policyDefinitions', 'full-access-policy')]"
    },
    "policyAssignmentId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Authorization/policyAssignments', 'full-access-assignment')]"
    }
  }
}
